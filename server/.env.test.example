# TokTickIT Test Environment Configuration
# Copy this file to .env.test or .env before running server tests:
# cp .env.test.example .env.test

# PostgreSQL database connection (Port 5233 for toktickit-db container, isolated toktickit_test)
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5233/toktickit_test?schema=public"
PORT=3103
UPLOAD_DIR="uploads_test"
NODE_ENV="test"
